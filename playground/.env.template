# =============================================================================
# laravel-barangay-search playground — env reference
# =============================================================================
# Copy to .env and fill in values:
#
#   cp .env.template .env
#   php artisan key:generate
#   php artisan serve
#
# Get an API key: https://gis.ph  ·  https://dashboard.gis.ph
# =============================================================================

# --- App ---
APP_NAME="Laravel Barangay Search Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- GIS.ph (required for search) ---
# Secret API key from the dashboard (gis_sk_…). Prefer restricted keys for demos.
GISPH_API_KEY=gis_sk_your_key_here

# Optional package cache overrides (see config/barangay-search.php)
# barangay_search_CACHE=true
# barangay_search_CACHE_TTL=3600

# --- Demo defaults (simple local setup) ---
DB_CONNECTION=sqlite
# DB_DATABASE is database/database.sqlite by default when using sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Unused by the demo (safe defaults) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
